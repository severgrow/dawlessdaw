{
  "name": "dawlessdaw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @dawlessdaw/web",
    "dev:fresh": "rm -rf apps/web/node_modules/.vite && npm run dev -w @dawlessdaw/web",
    "build": "npm run build -w @dawlessdaw/web",
    "build:desktop": "SPLOT_DESKTOP=1 npm run build -w @dawlessdaw/web",
    "desktop": "npm run build:desktop && npm run start -w @dawlessdaw/desktop",
    "dist:mac": "npm run build:desktop && npm run dist:mac -w @dawlessdaw/desktop",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "mpc-library": "node scripts/mpc-library-companion.mjs",
    "typecheck": "tsc -p apps/web/tsconfig.json --pretty false"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "playwright": "^1.49.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "optionalDependencies": {
    "@esbuild/darwin-arm64": "0.25.12",
    "@esbuild/darwin-x64": "0.25.12",
    "@rollup/rollup-darwin-arm64": "4.68.8",
    "@rollup/rollup-darwin-x64": "4.68.8"
  }
}
